							"raw": "{\n    \"qr_token\": \"meja-01\",\n    \"produk\": [\n        {\n            \"produk_id\": 1,\n            \"jumlah\": 2\n        },\n        {\n            \"produk_id\": 2,\n            \"jumlah\": 1\n        }\n    ],\n    \"catatan\": \"Jangan terlalu manis\"\n}",
